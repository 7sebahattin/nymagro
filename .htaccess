Options -Indexes
DirectoryIndex public/index.php index.php

RewriteEngine On

# Prevent direct web access to application code.
RewriteRule ^app(/|$) - [F,L]

# Send the domain root to the public front controller.
RewriteRule ^$ public/index.php [QSA,L]

# Route all non-public requests through the public directory.
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.+)$ public/$1 [QSA,L]
